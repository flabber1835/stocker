+def _assert_predecessor_state_commitment(
+        *, state: SessionState, cursor: date,
+        plan: ExecutionPlan | None, runtime_identity: Mapping) -> None:
+    """Prove a resumed path-dependent state is the state previously committed.
+
+    Same-session execution already binds ``state.state_hash`` to the current
+    plan.  A later-session preparation must make the same proof *before* that
+    state is allowed to seed the next deterministic transition.  Otherwise a
+    structurally valid database mutation can be laundered into a brand-new,
+    self-consistent plan on D+1.
+
+    The prior plan is only an integrity commitment here.  Its broker/rollout
+    economics are not reused for the new decision.
+    """
+    if plan is None:
+        raise PaperActivationRefused(
+            "canonical predecessor state has no durable plan commitment")
+    _assert_deterministic_plan_id(plan)
+    if state.last_processed_session != cursor.isoformat():
+        raise PaperActivationRefused(
+            "canonical predecessor state and processed-session cursor disagree")
+    if plan.decision_session != cursor:
+        raise PaperActivationRefused(
+            "canonical predecessor cursor is not the prior committed plan session")
+    if state.state_hash != plan.shadow_snapshot_hash:
+        raise PaperActivationRefused(
+            "canonical predecessor state fingerprint does not match the prior "
+            "committed plan")
+    if _hash(state.last_decision) != plan.sentinel_transition_hash:
+        raise PaperActivationRefused(
+            "canonical predecessor controller transition does not match the "
+            "prior committed plan")
+    if _hash(state.strategy_identity) != plan.strategy_fingerprint:
+        raise PaperActivationRefused(
+            "canonical predecessor strategy fingerprint does not match the "
+            "prior committed plan")
+    if state.strategy_identity != dict(runtime_identity):
+        raise PaperActivationRefused(
+            "persisted predecessor strategy/config/source identity differs "
+            "from runtime")
+    if state.data_version != plan.data_version:
+        raise PaperActivationRefused(
+            "canonical predecessor data version does not match the prior "
+            "committed plan")
+
