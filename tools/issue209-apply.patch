+def test_next_session_refuses_mutated_predecessor_state_before_advance(
+        conn, monkeypatch):
+    """A valid-looking SQL mutation cannot become tomorrow's strategy seed."""
+    bound = _bind(conn)
+    pinned = _publish(conn)
+    prior_state = _state(session=PRIOR, data_version=pinned.version)
+    _persist_state(conn, prior_state)
+
+    template = _plan(prior_state, pinned, bound)
+    prior_plan = ExecutionPlan(**{
+        **template.__dict__,
+        "plan_id": "pending",
+        "decision_session": PRIOR,
+        "effective_session": dt.date(2026, 8, 10),
+    })
+    prior_plan = ExecutionPlan(**{
+        **prior_plan.__dict__,
+        "plan_id": f"sentinel-{prior_plan.fingerprint()}",
+    })
+    journal.adopt_current_plan(conn, prior_plan)
+
+    corrupted = prior_state.to_dict()
+    corrupted["last_decision"]["reason"] = "CORRUPTED-BUT-VALID"
+    with conn.cursor() as cur:
+        cur.execute(
+            "UPDATE sentinel_processed_sessions SET state=%s::jsonb "
+            "WHERE session=%s",
+            (json.dumps(corrupted), PRIOR))
+    conn.commit()
+
+    _ready(monkeypatch)
+
+    def must_not_advance(*_args, **_kwargs):
+        raise AssertionError("corrupt predecessor reached strategy advance")
+
+    monkeypatch.setattr(paper, "advance_and_persist", must_not_advance)
+    broker = _broker()
+
+    with pytest.raises(
+            paper.PaperActivationRefused,
+            match="predecessor state fingerprint does not match"):
+        _prepare(conn, broker)
+
+    # Broker reads are permitted for clean reconciliation, but corruption must
+    # be refused before any new plan/state can be created.
+    assert journal.latest_plan(conn).plan_id == prior_plan.plan_id
