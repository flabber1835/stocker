# Broker-capable Sentinel membrane.
#
# This image is deliberately distinct from the ordinary read-only/development
# runtime.  The application requires the baked marker below, plus the explicit
# overlay intent flag, before it will dispatch any command that can construct a
# broker or enable signed authority.  The base image never receives this file.
#
# NO MUTABLE DEFAULT. A newly SHA-labelled authorized image must never inherit
# whatever `sentinel:latest` happened to mean on the build host. Deployment
# must name the exact reviewed base explicitly, so omission fails closed at
# FROM resolution instead of silently blessing stale source.
ARG SENTINEL_RUNTIME_BASE_IMAGE
FROM ${SENTINEL_RUNTIME_BASE_IMAGE}

ARG SOURCE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${SOURCE_GIT_SHA}

COPY deploy/sentinel-authorized-runtime-v1 \
    /opt/sentinel/authorized-runtime-v1
