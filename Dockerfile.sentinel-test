# The certified Sentinel runtime plus test-only tooling. This image is a CI lens,
# not a second deployable runtime. Every production layer comes from the single
# broker-capable Sentinel image and remains byte-identical below this test layer.
#
# The lens receives no broker credentials and does not set the explicit
# authorized-intent environment required by broker-capable commands.
ARG SENTINEL_IMAGE=sentinel:latest
FROM ${SENTINEL_IMAGE}
ARG SOURCE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${SOURCE_GIT_SHA}

USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql postgresql-client git \
 && rm -rf /var/lib/apt/lists/*

COPY tests/requirements.lock /tmp/test-req/requirements.lock
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        --no-deps -r /tmp/test-req/requirements.lock \
 && pip check

WORKDIR /work
COPY tests/ /work/tests/
COPY tools/ /work/tools/
COPY scripts/sentinel_feed_gate.py /work/scripts/sentinel_feed_gate.py
COPY scripts/sentinel_forward_run.py /work/scripts/sentinel_forward_run.py
COPY scripts/sentinel_test_run.py /work/scripts/sentinel_test_run.py
COPY scripts/sentinel_reconcile_sep.py /work/scripts/sentinel_reconcile_sep.py
COPY scripts/sentinel-measure.sh /work/scripts/sentinel-measure.sh
COPY scripts/ /work/repo/scripts/
COPY tools/ /work/repo/tools/

COPY docs/sentinel-handoff/00_README/ /work/docs/sentinel-handoff/00_README/
COPY docs/sentinel-handoff/02_SENTINEL_1P1_FROZEN_ORACLE/ /work/docs/sentinel-handoff/02_SENTINEL_1P1_FROZEN_ORACLE/
COPY docs/sentinel-handoff/04_BREADTH_ORACLES/ /work/docs/sentinel-handoff/04_BREADTH_ORACLES/
COPY docs/sentinel-handoff/00_README/ /work/repo/docs/sentinel-handoff/00_README/
COPY docs/sentinel-breadth-reconstruction/ /work/docs/sentinel-breadth-reconstruction/
COPY docs/sentinel-reference-implementation/ /work/docs/sentinel-reference-implementation/
COPY sentinel/ /work/repo/sentinel/
COPY shared/ /work/repo/shared/
COPY Dockerfile.sentinel /work/repo/Dockerfile.sentinel
COPY Dockerfile.sentinel-authorized /work/repo/Dockerfile.sentinel-authorized
COPY deploy/sentinel-authorized-runtime-v1 /work/repo/deploy/sentinel-authorized-runtime-v1
COPY docker-compose.sentinel.yml /work/repo/docker-compose.sentinel.yml
COPY docker-compose.sentinel-automation.yml /work/repo/docker-compose.sentinel-automation.yml
COPY docker-compose.sentinel-automation-standby.yml /work/repo/docker-compose.sentinel-automation-standby.yml
COPY Dockerfile.sentinel-test /work/repo/Dockerfile.sentinel-test
COPY docker-compose.sentinel-backup.yml /work/repo/docker-compose.sentinel-backup.yml
COPY .dockerignore /work/repo/.dockerignore
COPY .gitattributes /work/repo/.gitattributes
COPY .github/CODEOWNERS /work/repo/.github/CODEOWNERS
COPY .github/workflows/sentinel-publish.yml /work/repo/.github/workflows/sentinel-publish.yml
COPY .github/workflows/sentinel-safety.yml /work/repo/.github/workflows/sentinel-safety.yml
COPY .env.example /work/repo/.env.example
COPY Makefile /work/repo/Makefile
COPY README.md /work/repo/README.md
COPY docs/f92c0cc-safety-reconstruction.md /work/repo/docs/f92c0cc-safety-reconstruction.md
COPY docs/main-review-remediation.md /work/repo/docs/main-review-remediation.md
COPY docs/production-certification-separation.md /work/repo/docs/production-certification-separation.md
COPY docs/sentinel-deployment.md /work/repo/docs/sentinel-deployment.md
COPY docs/sentinel-paper-activation.md /work/repo/docs/sentinel-paper-activation.md
COPY docs/sentinel-stage-4-automation.md /work/repo/docs/sentinel-stage-4-automation.md
COPY docs/sentinel-paper-observation.md /work/repo/docs/sentinel-paper-observation.md
COPY docs/paper-lifecycle-equivalence.json /work/repo/docs/paper-lifecycle-equivalence.json
COPY config/paper-observation-boundary.json /work/repo/config/paper-observation-boundary.json

ENV PYTHONPATH=/work:/app \
    SENTINEL_REPO_ROOT=/work/repo \
    SENTINEL_IN_IMAGE=1 \
    SENTINEL_STATE_DIR=/tmp/sentinel-test-state

RUN python -c "from pathlib import Path; \
    import sentinel, stock_strategy_shared.wealth_core as wc; \
    from scripts import sentinel_feed_gate as feed_gate; \
    from scripts import sentinel_forward_run as forward_run; \
    assert sentinel.__file__.startswith('/app/'), sentinel.__file__; \
    assert '/work' not in wc.__file__, wc.__file__; \
    assert str(forward_run.DEFAULT_PRODUCTION).startswith('/app/'), forward_run.DEFAULT_PRODUCTION; \
    assert str(forward_run.DEFAULT_RUNNER).startswith('/work/tools/'), forward_run.DEFAULT_RUNNER; \
    assert feed_gate.__file__.startswith('/work/scripts/'), feed_gate.__file__; \
    assert Path('/work/scripts/sentinel-measure.sh').is_file(); \
    print('runtime imports OK:', sentinel.__file__, wc.__file__)"

ENTRYPOINT ["python", "-m", "pytest"]
CMD ["tests/sentinel", "-q"]
