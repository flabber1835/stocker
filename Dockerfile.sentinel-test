# The certified image, plus the tooling needed to TEST it. Nothing else.
#
# WHY A SECOND IMAGE INSTEAD OF ADDING pytest TO THE FIRST. A test run must
# exercise the environment production actually runs in — the same interpreter,
# the same exchange_calendars, the same pandas — and installing test tooling
# into the runtime image would change that environment while claiming to verify
# it. Layering on top keeps every runtime layer byte-identical:
# `sentinel-authorized:latest` is the deployable artefact, and this is a lens on
# it. The lens receives no broker credentials and does not set the separately
# required authorized-intent flag, so the baked marker cannot enable transport.
#
# WHY NOT RUN THE SUITE ON THE HOST. The whole point of the pins is that the
# host's Python is not the certified one. A green suite on a developer's 3.11
# with a different pandas says nothing about the image that will produce the
# evidence — which is exactly the gap `identity --require-certified` exists to
# close, and running the tests anywhere else re-opens it.
#
# ── AND THE MISTAKE THAT MADE THE FIRST VERSION USELESS ──────────────────────
#
# It copied `sentinel/` and `shared/` into /work and put /work first on
# PYTHONPATH. Pytest then imported the fresh CHECKOUT, not the runtime code:
#
#     deployable runtime holds stale or wrong /app/sentinel
#       + the test layer copies correct source into /work
#       -> every test green, artefact never executed
#
# The suite proved the checkout. It also hid a real defect — `identity` computed
# Wealth Core's path as `sentinel/../shared/...`, which exists under /work and
# does NOT exist in the runtime image, so the source hash was null there and
# nothing noticed.
#
# So the runtime code is NOT copied. Only tests, their fixtures, and a
# READ-ONLY copy of the repository for the tests that INSPECT it (the Dockerfile
# and the compose file are inputs to assertions about the image, not code to
# import). That copy lives at /work/repo, which is never on sys.path, and
# `SENTINEL_REPO_ROOT` points the inspecting tests at it.
ARG SENTINEL_IMAGE=sentinel-authorized:latest
FROM ${SENTINEL_IMAGE}
ARG SOURCE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${SOURCE_GIT_SHA}

# Postgres BINARIES, not a server: `tests/integration/conftest` spins up a
# throwaway cluster with initdb/pg_ctl per module. Without them every
# database-backed test SKIPS, and a suite that skipped is not a suite that
# passed — `scripts/sentinel-certify.sh` treats any skip in this image as a
# failure for exactly that reason.
# git is here for the same reason, and only that reason: the manifest tests
# drive `scripts/sentinel_manifest.py` against a repository dirty by
# construction, and without the binary that test ERRORS in this image while
# passing on every host. It is not in `sentinel:latest` and must not be — the
# runtime artefact has no business running git — but a skip HERE is a
# certification failure, so the lens has to carry what the suite needs.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql postgresql-client git \
 && rm -rf /var/lib/apt/lists/*

# HASH LOCKED like everything else — a test runner that floats can change a
# verdict between two runs of the same suite, and a version-only pin can resolve
# to different artifact bytes. This is a DELTA closure layered on the already
# hash-locked runtime image. `--no-deps` makes every added distribution come
# from this reviewed lock rather than asking pip to resolve anything; `pip
# check` then proves the combined runtime + test closure is complete.
#
# SQLAlchemy is here rather than in the runtime image on purpose: the canonical
# Wealth Core data path imports it at module scope, and it is a retired-Stocker-
# stack dependency. `tools/corpus_parity.py` needs it to read bt-postgres;
# `sentinel:latest` must not carry the retired platform's ORM into an image that
# liquidates an account.
COPY tests/requirements.lock /tmp/test-req/requirements.lock
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        --no-deps -r /tmp/test-req/requirements.lock \
 && pip check

WORKDIR /work
COPY tests/ /work/tests/
# The parity suite compares Sentinel's loader against the CANONICAL Wealth Core
# data path, which still lives in the backtester. Imported, never run — and if
# it is absent those tests SKIP rather than silently passing, which is why it is
# copied explicitly rather than left to chance. It shadows nothing: there is no
# `services` package in the runtime image.
COPY services/backtester/ /work/services/backtester/
COPY tools/ /work/tools/
COPY scripts/ /work/repo/scripts/

# INSPECTION ONLY. Never on sys.path — these are the inputs to assertions about
# the image, and importing them is precisely what this file exists to prevent.
# THE FROZEN HANDOFF ARTEFACTS. Both the code and the suite read them:
# `frozen_rule` loads its thresholds from the rule JSON and verifies the digest
# against SHA256SUMS.txt, and the controller certification replays the 5,032-
# session oracle tape. Copied to BOTH roots because the two resolve differently
# — tests are at /work/tests (parents[2] = /work) and the package at
# /work/repo/sentinel (parents[2] = /work/repo).
COPY docs/sentinel-handoff/00_README/ /work/docs/sentinel-handoff/00_README/
COPY docs/sentinel-handoff/02_SENTINEL_1P1_FROZEN_ORACLE/ /work/docs/sentinel-handoff/02_SENTINEL_1P1_FROZEN_ORACLE/
COPY docs/sentinel-handoff/04_BREADTH_ORACLES/ /work/docs/sentinel-handoff/04_BREADTH_ORACLES/
COPY docs/sentinel-handoff/00_README/ /work/repo/docs/sentinel-handoff/00_README/
# THE RECOVERED BREADTH CLASSIFIER, for the differential test only. The
# production module `sentinel/breadth/` is pure and reads neither of these at
# runtime; `test_breadth_classifier.py` imports the pandas artefact and compares
# it against the transcription on randomised books, so a semantic drift fails
# offline instead of surviving to the NAS run. Test-side root only — nothing
# under /work/repo/sentinel may reach them.
COPY docs/sentinel-breadth-reconstruction/ /work/docs/sentinel-breadth-reconstruction/
COPY docs/sentinel-reference-implementation/ /work/docs/sentinel-reference-implementation/
COPY sentinel/ /work/repo/sentinel/
COPY shared/ /work/repo/shared/
COPY Dockerfile.base /work/repo/Dockerfile.base
COPY Dockerfile.sentinel /work/repo/Dockerfile.sentinel
COPY Dockerfile.sentinel-authorized /work/repo/Dockerfile.sentinel-authorized
COPY deploy/sentinel-authorized-runtime-v1 /work/repo/deploy/sentinel-authorized-runtime-v1
COPY docker-compose.sentinel.yml /work/repo/docker-compose.sentinel.yml
COPY docker-compose.sentinel-automation.yml /work/repo/docker-compose.sentinel-automation.yml
COPY Dockerfile.sentinel-test /work/repo/Dockerfile.sentinel-test
# The certification harness resolves the bt-engine image out of THIS file and
# refuses a build context that hides a COPY source, so both are inputs to
# assertions the suite makes about the machinery. Without them those tests read
# a repo root where the file simply is not there — and in this image a skip is
# a FAILURE, so "absent" cannot quietly become "not checked".
COPY docker-compose.backtest.yml /work/repo/docker-compose.backtest.yml
COPY docker-compose.sentinel-backup.yml /work/repo/docker-compose.sentinel-backup.yml
COPY .dockerignore /work/repo/.dockerignore
COPY .gitattributes /work/repo/.gitattributes
COPY .github/workflows/sentinel-safety.yml /work/repo/.github/workflows/sentinel-safety.yml
COPY .env.example /work/repo/.env.example
COPY Makefile /work/repo/Makefile
COPY README.md /work/repo/README.md
COPY docs/main-review-remediation.md /work/repo/docs/main-review-remediation.md
COPY docs/sentinel-deployment.md /work/repo/docs/sentinel-deployment.md
COPY docs/sentinel-paper-activation.md /work/repo/docs/sentinel-paper-activation.md
COPY docs/sentinel-stage-4-automation.md /work/repo/docs/sentinel-stage-4-automation.md
# bt-engine RUNS the rehearsal and bt-data INGESTS the corpus, so several tests
# read their source to check what the engine records and how the feed maps a
# vendor row. INSPECTION ONLY — under /work/repo, never /work, so nothing here
# is importable and no `services` package shadows anything. That is the split:
# /work is what the suite imports, /work/repo is what it reads.
COPY services/bt-engine/ /work/repo/services/bt-engine/
COPY services/bt-data/ /work/repo/services/bt-data/
COPY services/backtester/ /work/repo/services/backtester/

# /work carries `tests` and `services`. `sentinel` resolves from /app and
# `stock_strategy_shared` from site-packages — the artefact, in both cases.
# /work/services/backtester is on the path because the canonical Wealth Core
# data path is `app.wealth_core_replay` — `app` is a top-level package INSIDE
# that directory, so /work alone resolves nothing and `tools.corpus_parity`
# would die on ModuleNotFoundError at the real-window parity step. It shadows
# nothing: the runtime image has no `app` package.
ENV PYTHONPATH=/work:/work/services/backtester:/app \
    SENTINEL_REPO_ROOT=/work/repo \
    SENTINEL_IN_IMAGE=1 \
    SENTINEL_STATE_DIR=/tmp/sentinel-test-state

# BEFORE any test runs. If the imports resolve to the wrong place the suite is
# measuring the wrong thing, and a failure here is far cheaper than a green run
# that certified a checkout.
RUN python -c "import sentinel, stock_strategy_shared.wealth_core as wc; \
    from app import wealth_core_replay as bt; \
    import tools.corpus_parity; \
    assert sentinel.__file__.startswith('/app/'), sentinel.__file__; \
    assert '/work' not in wc.__file__, wc.__file__; \
    print('runtime imports OK:', sentinel.__file__, wc.__file__, bt.__file__)"

# Overrides the runtime ENTRYPOINT, whose purpose is to refuse to be started
# casually. A test image needs a plain interpreter.
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["tests/sentinel", "-q"]
