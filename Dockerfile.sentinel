# Sentinel — the operational runtime that replaces Stocker.
#
# Built FROM python:3.12-slim, not from stocker-base. Sentinel reuses Stocker's
# proven components, including the broker adapter and Wealth Core engine, but
# does not inherit the retired platform image or its unrelated services.
#
# There is one deployable Sentinel runtime image. It contains both ordinary
# operational code and broker-capable handlers. Broker execution remains gated
# by the reviewed command/authority/certificate checks; image splitting is not
# part of the authority model.
#
# The base is pinned by digest. This digest is python 3.12.13 and is asserted at
# runtime by sentinel.identity.
FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN sed -i 's/MinProtocol = TLSv1.2/MinProtocol = TLSv1.2\nMaxProtocol = TLSv1.2/' \
    /etc/ssl/openssl.cnf

# Install the pinned dependency closure before application source so normal
# source-only changes reuse these content-addressed layers.
COPY sentinel/requirements.txt sentinel/requirements.lock /tmp/req/
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        -r /tmp/req/requirements.lock

COPY shared/ /shared/
RUN pip install --no-cache-dir --no-build-isolation --no-deps /shared/

# Stable runtime filesystem identity also sits below mutable source.
ENV SENTINEL_STATE_DIR=/var/lib/sentinel
RUN groupadd --system --gid 10001 sentinel \
    && useradd --system --uid 10001 --gid 10001 \
         --home-dir /var/lib/sentinel --shell /usr/sbin/nologin sentinel \
    && mkdir -p /var/lib/sentinel \
    && chown -R 10001:10001 /var/lib/sentinel

# Consume source identity only after the stable dependency/shared/user layers.
# The final immutable image still binds the exact commit through both the OCI
# label and the process-visible environment value.
ARG SOURCE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${SOURCE_GIT_SHA}
ENV SENTINEL_IMAGE_SOURCE_REVISION=${SOURCE_GIT_SHA}

# Frozen reviewed-rule inputs and application source.
COPY docs/sentinel-handoff/00_README/ ./docs/sentinel-handoff/00_README/
COPY config/paper-observation-boundary.json \
     /app/config/paper-observation-boundary.json
COPY sentinel/ /app/sentinel/

# The production GO parity replay is broker-free and read-only. Carry its exact
# helper and frozen corrected-lineage tape in this same immutable runtime so a
# NAS validating a CI-certified commit never needs a second deployable/test
# image. The diagnostic has no execution/broker imports and persists no state.
COPY tools/__init__.py /app/tools/__init__.py
COPY tools/sentinel_forward_chain.py /app/tools/sentinel_forward_chain.py
COPY docs/sentinel-reference-implementation/ \
     /app/docs/sentinel-reference-implementation/

# Broker-capable code is intentionally present in this one runtime image.
# shared/ already contains stock_strategy_shared.broker.alpaca and sentinel/
# contains the authorized command routes and Alpaca execution handlers.
#
# The marker/capability pair remains a baked, root-owned launch/command membrane
# used by require_authorized_runtime(). It no longer signifies a second image;
# it proves that the immutable Sentinel runtime was built with the reviewed
# execution-capability contract. Standing broker authority still requires the
# separate runtime intent, signed authority and account/environment checks.
COPY deploy/sentinel-authorized-runtime-v1 \
    /opt/sentinel/authorized-runtime-v1
USER root
RUN install -d -m 0755 /opt/sentinel/bin \
    && chmod 0444 /opt/sentinel/authorized-runtime-v1 \
    && chown root:root /opt/sentinel/authorized-runtime-v1 \
    && printf '%s\n' \
       '#!/bin/sh' \
       'printf "sentinel-authorized-capability/1\\n"' \
       > /opt/sentinel/bin/authorized-runtime-capability-v1 \
    && chmod 0555 /opt/sentinel/bin/authorized-runtime-capability-v1 \
    && chown root:root /opt/sentinel/bin/authorized-runtime-capability-v1

# Financial runtime processes do not require host-root authority.
USER 10001:10001

# Container start/restart is inert with respect to trading. Broker-capable
# commands require an explicit CLI invocation plus their existing authority
# gates; the image default remains status only.
ENTRYPOINT ["python", "-m", "sentinel"]
CMD ["status"]
