# Sentinel — the operational runtime that replaces Stocker.
#
# Built FROM python:3.12-slim, not from stocker-base. Sentinel reuses Stocker's
# proven COMPONENTS (the broker adapter, later the Wealth Core engine) but must
# not inherit its image: stocker-base carries the whole shared package plus every
# transitive dependency the retired services needed, and an image that pulls in a
# retired platform is not a retirement.
#
# `shared/` is installed because `stock_strategy_shared.broker` and
# `stock_strategy_shared.wealth_core` live there and are carried forward intact.
# When Sentinel splits into its own repository those move with it.
#
# NOT editable-installed. docker-compose.override.yml bind-mounts ./shared for
# the live Stocker stack so a `git pull` takes effect without a rebuild; that
# convenience is also how a container ends up running code nobody built. Sentinel
# runs what was built, and a change means a rebuild.
# THE BASE IS PINNED BY DIGEST, NOT BY TAG. `python:3.12-slim` is a moving
# pointer: the same Dockerfile built a week apart yields a different Python
# patch level and a different Debian package set. Once a rehearsal result is
# certification evidence, reproducing the environment is part of reproducing the
# answer, and a tag cannot do that. This digest is python 3.12.13 — asserted at
# runtime by `sentinel.identity`, so an image built from a different base fails
# loudly instead of quietly producing a second answer.
FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org pypi.python.org"

RUN sed -i 's/MinProtocol = TLSv1.2/MinProtocol = TLSv1.2\nMaxProtocol = TLSv1.2/' \
    /etc/ssl/openssl.cnf

# ORDER MATTERS, AND IT IS THE REVERSE OF THE OBVIOUS ONE. The pinned closure
# is installed FIRST, then `shared/` with `--no-deps`, so the package
# contributes its CODE and not its resolver. Installed the other way round,
# `shared/pyproject.toml`'s `pydantic>=2.0` and `pyyaml>=6.0` would float
# freely — and `pin_drift()` only reads `sentinel/requirements.txt`, so the two
# most load-bearing libraries in the Wealth Core config path could move without
# appearing anywhere in the identity record that claims to name the
# environment. They are pinned in requirements.txt for exactly that reason.
#
# THE LOCK WINS WHEN IT EXISTS. `requirements.txt` pins the DIRECT
# dependencies; pip resolves everything underneath them freely, so two builds a
# month apart can declare the same versions and install different closures.
# `sentinel/requirements.lock` is that closure read back OUT of a real build by
# `scripts/sentinel-lock.sh`. It does not exist until the first Python 3.12.13
# build has happened — which is why this falls back rather than requiring it,
# and why the fallback prints loudly instead of passing quietly.
#
# `identity` fingerprints the installed set either way, so an unlocked build
# can never be MISTAKEN for a locked one; the lock is what makes it
# REPRODUCIBLE.
COPY sentinel/requirements*.* /tmp/req/
RUN if [ -f /tmp/req/requirements.lock ]; then \
        echo "installing the RESOLVED CLOSURE (requirements.lock)"; \
        pip install --no-cache-dir -r /tmp/req/requirements.lock; \
    else \
        echo "*** NO requirements.lock — installing from requirements.txt and"; \
        echo "*** letting pip resolve the transitive closure. This build is"; \
        echo "*** NOT reproducible. Run scripts/sentinel-lock.sh against it,"; \
        echo "*** commit the lock, and rebuild before certifying anything."; \
        pip install --no-cache-dir -r /tmp/req/requirements.txt; \
    fi

COPY shared/ /shared/
RUN pip install --no-cache-dir --no-deps /shared/

# The Postgres driver. NOT a transitive dependency of `shared/`, which declares
# only pydantic and pyyaml — every Stocker service installed its own driver, so
# nothing in `shared/` ever pulled one in and Sentinel inherited that gap.
#
# `sentinel.feed.store.connect` imports it LAZILY (psycopg3 preferred, psycopg2
# accepted) so the package stays testable without a driver installed. That is
# the right design and it is also why the omission was invisible: the image
# built clean, `status` worked because it deliberately touches no database, and
# every feed command failed at the first connection instead — including a
# DETACHED `feed-seed`, which dies silently and looks exactly like a seed that
# is running.
#
# [binary] so there is no libpq/build-essential in the runtime image.
#
# httpx is the HTTP client, and it is reachable from TWO places that fail at
# different times: `sentinel/feed/sharadar.py` (the corpus fetch) and
# `stock_strategy_shared/broker/base.py` (the broker adapter). Both import it
# lazily, so the second one would not have failed until `migrate-account`
# tried to talk to Alpaca — i.e. during a liquidation.
#
# BOTH of these were missed by reading top-level imports. Every dependency this
# image needs is imported lazily, by design, so the import graph does not show
# them. `tests/sentinel/test_image_layout.py` now walks the graph with AST and
# fails if the image does not carry what the walk finds.
#
# EXACT PINS, in a file rather than on this line — see sentinel/requirements.txt
# for why the calendar stack in particular is a certification dependency and not
# ordinary package hygiene. The install itself happens ABOVE, before `shared/`,
# so that package cannot resolve its own dependency ranges.

# THE FROZEN RULE. `sentinel/controller/frozen_rule.py` loads its thresholds
# from here and RAISES if absent — it will not fall back to transcribed
# constants, because a Sentinel running on numbers nobody verified is an
# uncertified strategy wearing a certified name. Only the rule and its digest
# manifest; the oracle tapes are certification evidence and belong to the test
# image.
COPY docs/sentinel-handoff/00_README/ ./docs/sentinel-handoff/00_README/
COPY sentinel/ /app/sentinel/

# `ownership.jsonl` lives HERE as retained audit evidence — see
# docker-compose.sentinel.yml. The canonical ownership authority is the account
# binding in PostgreSQL, beside the behavioral state it protects. Losing this
# file cannot re-arm a liquidation: ordinary startup has no legacy-book
# liquidation path, and only the explicit `migrate-account` operation may enter
# that administrative state machine. The directory still exists in the image so
# a configured audit-volume mount has a stable, writable target.
ENV SENTINEL_STATE_DIR=/var/lib/sentinel
RUN mkdir -p /var/lib/sentinel

# No default command that TRADES. `migrate-account` liquidates a LEGACY book;
# it is not something a container restart policy should be able to trigger on its
# own. The default is the read-only status view, and the real action is an
# explicit `docker compose run`.
ENTRYPOINT ["python", "-m", "sentinel"]
CMD ["status"]
