# Copy to .env and fill locally. Never commit .env.

# Required for Sentinel PostgreSQL. There is deliberately no default.
SENTINEL_POSTGRES_PASSWORD=replace-with-a-long-random-value

# Required for the separate Wealth Core certification database.
BT_POSTGRES_PASSWORD=replace-with-a-different-long-random-value

# Sharadar/Nasdaq Data Link corpus access.
SHARADAR_API_KEY=

# Alpaca PAPER account only. Broker commands additionally verify the observed
# account id and the exact paper endpoint before any mutation can be authorized.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional bounded runtime controls.
SENTINEL_MAX_CYCLES=40
SENTINEL_POLL_SECONDS=5
BT_ENGINE_MEM_LIMIT=4g
STALE_BT_RUN_HOURS=12

# Backtest data mode. `synthetic` is test evidence only and cannot certify a
# production rehearsal.
BT_DATA_MODE=sharadar
BT_MOCK_DATA=false

# Optional local image identity injected by scripts/bt-engine-up.sh.
BT_ENGINE_IMAGE=
BT_ENGINE_IMAGE_ID=

# Backup overlay prerequisite: an operator-owned path on a second durable
# target, not inside the repository or the sentinel_pgdata volume.
SENTINEL_BACKUP_DIR=
# Required only when the backup target's mount layer reports the same Linux
# device number as Docker's data root, or Docker's root cannot be inspected.
# Set to 1 only after an operator verifies independent durable storage.
SENTINEL_BACKUP_DURABLE_TARGET_ATTESTED=0
SENTINEL_BACKUP_MAX_AGE_HOURS=30

# ---------------------------------------------------------------------------
# Fully autonomous ALPACA PAPER deployment
# ---------------------------------------------------------------------------
# After these one-time facts are configured, a normal deployment is:
#   bash scripts/sentinel-autonomous-deploy.sh
# The launcher fast-forwards main itself, but `git pull --ff-only` first is also
# fine. It never resets/reseeds the database or guesses account ownership.
SENTINEL_DEPLOYMENT_ID=
SENTINEL_PAPER_ACCOUNT_ID=

# Registry repositories, WITHOUT a tag or @digest. Docker registry login must
# already be configured on the NAS. The deployer tags by the exact 40-hex Git
# SHA, pushes, then deploys only the captured immutable RepoDigest.
SENTINEL_RUNTIME_IMAGE_REPOSITORY=
SENTINEL_TEST_IMAGE_REPOSITORY=

# Directory retained for signed authority/deployment evidence. This may be an
# ignored local path such as artifacts/sentinel/authority or a durable mount.
SENTINEL_AUTHORITY_ARTIFACTS_DIR=artifacts/sentinel/authority

# Existing, separately enrolled Ed25519 signing key. The PRIVATE key must live
# outside the Git checkout (for example a USB path). Signing runs in the exact
# new test image with --network none and mounts this file read-only. The public
# key id must already be ACTIVE in sentinel/trust_roots.json; deployment never
# guesses or rewrites trust anchors. To rotate signing keys, commit/enroll the
# new ACTIVE public root first, then point these two values at its private key/id.
SENTINEL_DEPLOY_SIGNING_KEY_FILE=
SENTINEL_DEPLOY_SIGNING_KEY_ID=
# Optional key-rotation cleanup. When 1 and the newly configured signing key is
# different from the key that signed the predecessor execution certificate, the
# deployer activates the new certificate first and then durably revokes the old
# key before enabling automation. Leave 0 when retaining the old key is desired.
SENTINEL_DEPLOY_REVOKE_PREVIOUS_SIGNING_KEY=0

# Renewable paper observation authority. Keep the canonical decimal spelling:
# 1, 0, or e.g. 0.75 (not 1.0). The short future boundary lets install complete
# as STAGED; the deployer waits automatically before activation if necessary.
SENTINEL_DEPLOY_MAXIMUM_EXPOSURE=1
SENTINEL_DEPLOY_NOT_BEFORE_MARGIN_SECONDS=120
SENTINEL_DEPLOY_HEALTH_TIMEOUT_SECONDS=300
SENTINEL_DEPLOY_ACTOR=sentinel-autonomous-deploy
SENTINEL_DEPLOY_REVIEWER=sentinel-autonomous-deploy
SENTINEL_DEPLOY_TICKET_PREFIX=autonomous-deploy

# Existing bound deployments leave this 0. A truly NEW and EMPTY paper account
# may set it to 1 once. Even then the deployer obtains dedicated ADMIN_BIND_EMPTY
# authority, performs the complete broker inspection, and refuses any position,
# working order, or other non-flat evidence. It NEVER auto-runs migrate-account.
SENTINEL_DEPLOY_ALLOW_EMPTY_BIND=0

# The deploy branch is main in production. This exists only for controlled
# staging; the launcher refuses detached heads and non-matching branches.
SENTINEL_DEPLOY_GIT_BRANCH=main
