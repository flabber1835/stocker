# Copy to .env and fill locally. Never commit .env.

# Required for Sentinel PostgreSQL. There is deliberately no default.
SENTINEL_POSTGRES_PASSWORD=replace-with-a-long-random-value

# Required for the separate Wealth Core certification database.
BT_POSTGRES_PASSWORD=replace-with-a-different-long-random-value

# Sharadar/Nasdaq Data Link corpus access.
SHARADAR_API_KEY=

# Alpaca PAPER account only. Broker commands additionally verify the observed
# account id and the exact paper endpoint before any mutation can be authorized.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional bounded runtime controls.
SENTINEL_MAX_CYCLES=40
SENTINEL_POLL_SECONDS=5
BT_ENGINE_MEM_LIMIT=4g
STALE_BT_RUN_HOURS=12

# Backtest data mode. `synthetic` is test evidence only and cannot certify a
# production rehearsal.
BT_DATA_MODE=sharadar
BT_MOCK_DATA=false

# Optional local image identity injected by scripts/bt-engine-up.sh.
BT_ENGINE_IMAGE=
BT_ENGINE_IMAGE_ID=

# Backup overlay prerequisite: an operator-owned path on a second durable
# target, not inside the repository or the sentinel_pgdata volume.
SENTINEL_BACKUP_DIR=
# Required only when the backup target's mount layer reports the same Linux
# device number as Docker's data root, or Docker's root cannot be inspected.
# Set to 1 only after an operator verifies independent durable storage.
SENTINEL_BACKUP_DURABLE_TARGET_ATTESTED=0
SENTINEL_BACKUP_MAX_AGE_HOURS=30

# ---------------------------------------------------------------------------
# Fully autonomous ALPACA PAPER deployment
# ---------------------------------------------------------------------------
# Normal existing-NAS use is simply:
#   bash scripts/sentinel-autonomous-deploy.sh
# The launcher fast-forwards main itself; `git pull --ff-only` first is harmless.
# It never resets/reseeds the database or guesses account ownership.
#
# The next four values are OPTIONAL overrides for an existing OWNED deployment:
# deployment/account are recovered from canonical PostgreSQL status, and the
# runtime registry repository is recovered from the existing automation image.
# If TEST_IMAGE_REPOSITORY is omitted it defaults to <runtime-repository>-test.
# Any explicit value must agree with the recovered durable fact.
SENTINEL_DEPLOYMENT_ID=
SENTINEL_PAPER_ACCOUNT_ID=
SENTINEL_RUNTIME_IMAGE_REPOSITORY=
SENTINEL_TEST_IMAGE_REPOSITORY=

# Directory retained for signed authority/deployment evidence. The default is
# ignored by Git. A durable external mount may be supplied instead.
SENTINEL_AUTHORITY_ARTIFACTS_DIR=artifacts/sentinel/authority

# Existing, separately enrolled Ed25519 signing key. The PRIVATE key must live
# outside the Git checkout (for example a USB/home secret path). Signing runs in
# the exact new test image with --network none and mounts this file read-only.
# The public key must already be ACTIVE in sentinel/trust_roots.json; deployment
# never guesses or adds a trust root.
#
# The FILE may be omitted only when exactly one conventional key exists at one
# of ~/.config/sentinel/{signing-key.ed25519,signing-key.pem} or
# ~/.sentinel/{signing-key.ed25519,signing-key.pem}. The key ID is optional: the
# deployer derives it from the private key and proves the corresponding root is
# current+ACTIVE before touching the running deployment.
SENTINEL_DEPLOY_SIGNING_KEY_FILE=
SENTINEL_DEPLOY_SIGNING_KEY_ID=
# To rotate signing keys, commit/enroll the new ACTIVE public root first, then
# point the FILE at its private key (the ID may stay blank). When this switch is
# 1, the new execution certificate is activated first and the predecessor key
# is then durably revoked before automation is enabled.
SENTINEL_DEPLOY_REVOKE_PREVIOUS_SIGNING_KEY=0

# Renewable paper observation authority. Use canonical certificate spelling:
# 0, 1, or e.g. 0.75 (not 0.0/1.0/trailing-zero decimals). The short future
# boundary lets install complete as STAGED; activation waits automatically.
SENTINEL_DEPLOY_MAXIMUM_EXPOSURE=1
SENTINEL_DEPLOY_NOT_BEFORE_MARGIN_SECONDS=120
SENTINEL_DEPLOY_HEALTH_TIMEOUT_SECONDS=300

# Deployment is allowed at any hour. If XNYS has closed but Sharadar has not yet
# published that session, Sentinel remains disabled+killed and retries only the
# freshness-only data state. Build/test/promotion and the pre-migration backup
# are not repeated. Any other readiness failure still refuses immediately.
SENTINEL_DEPLOY_DATA_RETRY_SECONDS=300
SENTINEL_DEPLOY_DATA_WAIT_TIMEOUT_SECONDS=43200

SENTINEL_DEPLOY_ACTOR=sentinel-autonomous-deploy
SENTINEL_DEPLOY_REVIEWER=sentinel-autonomous-deploy
SENTINEL_DEPLOY_TICKET_PREFIX=autonomous-deploy

# Existing bound deployments leave this 0. A truly NEW and EMPTY paper account
# may set it to 1 once. Even then the deployer obtains dedicated ADMIN_BIND_EMPTY
# authority, performs the complete broker inspection, and refuses incomplete
# evidence, any position, or any working order. It NEVER auto-runs migrate-account.
SENTINEL_DEPLOY_ALLOW_EMPTY_BIND=0

# Production is main. This exists only for controlled staging; the launcher
# refuses detached heads and non-matching branches.
SENTINEL_DEPLOY_GIT_BRANCH=main