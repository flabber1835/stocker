# Test lens for the production bt-engine image.  Runtime code and dependencies
# come from the image below; the checkout is copied only under /work/repo for
# source-contract assertions and is never placed on sys.path.
ARG BT_ENGINE_IMAGE=stocker-bt-engine:latest
FROM ${BT_ENGINE_IMAGE}
ARG SOURCE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${SOURCE_GIT_SHA}

COPY tests/bt_engine/requirements.lock /tmp/bt-engine-test/requirements.lock
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
        --no-deps -r /tmp/bt-engine-test/requirements.lock \
 && pip check

WORKDIR /work
COPY pytest.ini /work/pytest.ini
COPY tests/bt_engine/ /work/tests/bt_engine/

# Inspection bundle.  `BT_ENGINE_REPO_ROOT` points source-reading tests here;
# the production package remains /app/app and /work/repo is not importable.
COPY services/bt-engine/Dockerfile /work/repo/services/bt-engine/Dockerfile
COPY services/bt-engine/Dockerfile.test /work/repo/services/bt-engine/Dockerfile.test
COPY services/bt-engine/app/ /work/repo/services/bt-engine/app/
COPY services/backtester/app/wealth_core_replay.py /work/repo/services/backtester/app/wealth_core_replay.py
COPY services/backtester/app/wealth_core_replay_impl.py /work/repo/services/backtester/app/wealth_core_replay_impl.py

ENV PYTHONPATH=/app:/work \
    BT_ENGINE_IN_IMAGE=1 \
    BT_ENGINE_REPO_ROOT=/work/repo

# Fail the build itself if the inspection checkout can shadow either executable
# production module.  The canonical loader is the COPY assembled by the
# production Dockerfile at /app/app/live, not the source-inspection copy.
RUN python -c "import app.wealth_core_api as api; \
    from app.live import wealth_core_replay as replay; \
    assert api.__file__.startswith('/app/app/'), api.__file__; \
    assert replay.__file__.startswith('/app/app/live/'), replay.__file__; \
    assert '/work/repo' not in api.__file__, api.__file__; \
    print('bt-engine runtime imports OK:', api.__file__, replay.__file__)"

ENTRYPOINT ["python", "-m", "pytest"]
