# URL is the only trading-mode selector. Supply credentials for that same
# Alpaca environment through the existing private deployment environment.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Real-money origin: https://api.alpaca.markets
# Do not change an existing PAPER database binding into a LIVE binding. Use
# the separately provisioned empty LIVE deployment described in the design.

# One-time LIVE qualification/enrollment supplies PUBLIC signed artifacts.
# Example container paths below are deliberately commented out. Missing or
# expired authority refuses LIVE operations. Never mount issuer private keys.
# SENTINEL_AUTHORITY_ARTIFACTS_DIR=/absolute/host/public-authority
# SENTINEL_LIVE_TRUST_ROOTS_PATH=/var/lib/sentinel-authority/live-trust-roots.json
# SENTINEL_LIVE_CERTIFICATE_PATH=/var/lib/sentinel-authority/live-certificate.json
# SENTINEL_LIVE_PROVISIONING_CERTIFICATE_PATH=/var/lib/sentinel-authority/live-provisioning-certificate.json
# SENTINEL_LIVE_FUNDING_CERTIFICATE_PATH=/var/lib/sentinel-authority/live-funding-certificate.json
